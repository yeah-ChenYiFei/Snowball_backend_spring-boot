# ============================
# SnowBall 后端环境变量参考
# ============================
# 生产环境：复制为 .env，修改所有密码/密钥，然后 source .env 启动应用
# 开发环境：无需设置，Spring Boot 会使用 application-dev.properties 中的默认值

# ── 数据库 ──
DB_URL=jdbc:mysql://localhost:3306/snowball?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=snowball
DB_PASSWORD=你的数据库密码

# ── MinIO 对象存储 ──
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=你的minio访问密钥
MINIO_SECRET_KEY=你的minio秘密密钥
MINIO_BUCKET=snowball

# ── JWT ──
JWT_SECRET=至少32字符的随机密钥

# ── SMTP 邮件 ──
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=你的QQ邮箱
SMTP_PASSWORD=你的QQ邮箱授权码
